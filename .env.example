# Copy to .env and fill in. .env is gitignored and must stay that way --
# it holds an AWS secret key and the tunnel credential.
#
#   cp .env.example .env
#
# WHY THE IMAGE TAGS ARE HERE RATHER THAN IN docker-compose.yml
#
# The tag is the one thing that legitimately differs between what EKS runs and
# what this host runs, because they are promoted independently. Keeping it in
# .env means the compose file describes the SHAPE and this file describes the
# VERSION -- and the shape can be committed while the version moves.
#
# Tags are git SHAs, the same scheme `make deploy` uses. Read the current one
# for any service with:
#
#   git -C ../links-service rev-parse --short HEAD
#
# or look at what is actually in the registry:
#
#   aws ecr describe-images --repository-name app-hub/links-service \
#     --region ap-south-1 \
#     --query 'sort_by(imageDetails,&imagePushedAt)[-1].imageTags[0]' --output text

ECR_HOST=314146298861.dkr.ecr.ap-south-1.amazonaws.com

LINKS_SERVICE_TAG=CHANGEME
GATEWAY_TAG=CHANGEME
AGGREGATOR_TAG=CHANGEME

# ---------------------------------------------------------------------------
# DynamoDB -- the SAME table the EKS deployment uses (C-04, infra/persistent/).
#
# Shared deliberately. A local store would give two divergent catalogues of the
# thing you use every day: add a link here, it is missing next time the cluster
# comes up. See README for the trade-off in full.
# ---------------------------------------------------------------------------
LINKS_TABLE_NAME=app-hub-links
AWS_REGION=ap-south-1

# ---------------------------------------------------------------------------
# THE CREDENTIAL THIS DEPLOYMENT NEEDS AND THE CLUSTER DOES NOT.
#
# On EKS, IRSA gives the pod a short-lived identity with no stored secret --
# nothing to leak, rotate or commit. There is no IRSA on a plain host, so this
# is a real long-lived key sitting in a file.
#
# Scope it hard: a dedicated IAM user, four DynamoDB actions on one table,
# plus read-only pull on the three ECR repositories. Nothing else. Then the
# worst case is someone reading and writing a list of bookmarks.
#
# See README for the exact policy and why the secret is created by hand rather
# than by Terraform.
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=CHANGEME
AWS_SECRET_ACCESS_KEY=CHANGEME

# ---------------------------------------------------------------------------
# TAILSCALE -- the way in. Chosen over Cloudflare Tunnel because it gives a
# stable public HTTPS hostname with no domain purchase. See README.
#
# The auth key comes from the admin console: Settings -> Keys -> Generate.
# It IS a credential -- anyone holding it can join a device to your tailnet.
#
# GENERATE IT REUSABLE, NOT EPHEMERAL, AND TAGGED `tag:app-hub`:
#   - ephemeral nodes are DELETED when they go offline, and the hostname is
#     what the URL is built from, so an ephemeral node means a moving URL
#   - reusable means recreating the container does not need a fresh key
#   - TAGGED is what lets this node use Funnel at all. tailscale-acl.hujson
#     grants the `funnel` attribute to `tag:app-hub` and to nothing else, so an
#     UNTAGGED key produces a node that joins fine, looks healthy, and whose
#     public URL never answers. Tagging also removes node-key expiry, which
#     learn/34 flags as a 180-day time bomb for an always-on host.
#   - the tag must already exist in the ACL's `tagOwners` before the key is
#     generated, or login is rejected with an error that reads like a bad key
#
# IT IS ONLY NEEDED ONCE. After the first successful login the node identity
# lives in the `tailscale-state` Docker volume and this line can be emptied.
# It is needed again only if that volume is destroyed.
# ---------------------------------------------------------------------------
TS_AUTHKEY=CHANGEME

# THIS BECOMES YOUR URL:  https://<TS_HOSTNAME>.<your-tailnet>.ts.net
# Change it and the URL changes with it.
TS_HOSTNAME=app-hub

# ---------------------------------------------------------------------------
# n8n timezone. BOTH TZ and GENERIC_TIMEZONE are set from this one value,
# because D-22 was caused by setting only one: the container ran UTC while
# the Schedule Trigger was written in IST, so the cost watchdog's "17:00"
# meant 22:30 local and it never fired at the intended hour.
# ---------------------------------------------------------------------------
N8N_TZ=Asia/Kolkata
