{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LinksTableCrudOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:ap-south-1:314146298861:table/app-hub-links"
    },
    {
      "Sid": "EcrAuthTokenIsAccountWideByApiShape",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "EcrPullTheThreeAppHubReposOnly",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchCheckLayerAvailability"
      ],
      "Resource": [
        "arn:aws:ecr:ap-south-1:314146298861:repository/app-hub/links-service",
        "arn:aws:ecr:ap-south-1:314146298861:repository/app-hub/gateway",
        "arn:aws:ecr:ap-south-1:314146298861:repository/app-hub/aggregator"
      ]
    }
  ]
}
